# Template for the two-node GPU-prefill / CPU-decode host configuration.
#
#   cp vllm/scripts/disagg_hosts.env.example vllm/scripts/disagg_hosts.env
#   # fill in the two addresses, then on BOTH nodes before run_disagg_2vm.sh:
#   source ~/work/villum-cuda/vllm/scripts/disagg_hosts.env   # on the prefill node
#   source ~/work/villum-cpu/vllm/scripts/disagg_hosts.env    # on the decode node
#
# The filled-in disagg_hosts.env is gitignored on purpose: these addresses are per-deployment,
# and on clouds that hand out DHCP leases they can change across a reboot or a shelve/unshelve
# cycle. Copy this template on each node rather than committing live addresses.
#
# Both nodes MUST be on a subnet where they route to each other DIRECTLY. Do not use floating
# or public addresses: UCX advertises its own data-path address by enumerating local NICs and
# has no knowledge of NAT, so a NAT'd peer is handed an address it cannot dial. See Issue 3 in
# the engineering journal.
#
# Find each node's address with:   ip -4 -o addr show scope global
# Pick the one on the shared subnet - NOT a container bridge (172.17.x, 172.18.x, ...), which
# both nodes are likely to have identically and which routes nowhere useful. See Issue 4.

export PREFILL_HOST=CHANGE_ME   # GPU node, the prefill leg      e.g. 10.3.200.85
export DECODE_HOST=CHANGE_ME    # CPU node, the decode leg       e.g. 10.3.200.112

# Informational only - run_disagg_2vm.sh derives the interface itself, per node, with
# `ip route get <peer>`, so it stays correct if the topology changes. Recorded here because
# pinning UCX to it is a correctness requirement, not a tuning knob (Issue 4).
export DISAGG_NIC=CHANGE_ME     # interface routing between them e.g. enp1s0

# ---- guards: keep these when you copy the file ----
if [ "${PREFILL_HOST}" = CHANGE_ME ] || [ "${DECODE_HOST}" = CHANGE_ME ]; then
  echo "ERROR: disagg_hosts.env still contains template values."
  echo "       Edit PREFILL_HOST and DECODE_HOST before running run_disagg_2vm.sh."
  # Unset rather than leave CHANGE_ME exported: a non-empty placeholder would satisfy
  # run_disagg_2vm.sh's ${VAR:?} guard and fail later with a much less obvious error.
  unset PREFILL_HOST DECODE_HOST DISAGG_NIC
else
  # Fail loudly if the leases moved, rather than letting UCX fail confusingly later.
  # `tr` is required: without it the list is NEWLINE-separated, the `case` patterns below
  # look for " <ip> " with spaces, nothing ever matches, and every host warns falsely.
  _myips=$(ip -4 -o addr show scope global | awk '{print $4}' | cut -d/ -f1 | tr '\n' ' ')
  case " $_myips " in
    *" $PREFILL_HOST "*|*" $DECODE_HOST "*) ;;
    *) echo "WARNING: this host ($(hostname)) has none of the addresses in disagg_hosts.env"
       echo "         local: $_myips"
       echo "         expected $PREFILL_HOST (prefill) or $DECODE_HOST (decode)"
       echo "         the leases probably changed - update this file";;
  esac
  unset _myips
fi

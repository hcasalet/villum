# Private addresses of the two-node disagg pair (Jetstream2 project network 10.3.200.0/24).
# Source on BOTH nodes before run_disagg_2vm.sh:
#   source ~/work/villum-cuda/vllm/scripts/disagg_hosts.env   # on the prefill node
#   source ~/work/villum-cpu/vllm/scripts/disagg_hosts.env    # on the decode node
#
# WARNING: these are DHCP leases (~21 h at the time of writing). They survive a reboot but
# not necessarily a shelve/unshelve cycle. Re-check after any unshelve:
#   ip -4 -o addr show scope global
export PREFILL_HOST=10.3.200.85     # goldenberry,  A100 + AMD EPYC Milan
export DECODE_HOST=10.3.200.112     # disagg-inf-1, Xeon 8468 w/ AMX (H100 unused)
export DISAGG_NIC=enp1s0            # the ONLY interface that routes between the two

# Fail loudly if the leases moved, rather than letting UCX fail confusingly later.
# `tr` is required: without it the list is NEWLINE-separated, the `case` patterns below
# look for " <ip> " with spaces, nothing ever matches, and every host warns falsely.
_myips=$(ip -4 -o addr show scope global | awk '{print $4}' | cut -d/ -f1 | tr '\n' ' ')
case " $_myips " in
  *" $PREFILL_HOST "*|*" $DECODE_HOST "*) ;;
  *) echo "WARNING: this host ($(hostname)) has none of the addresses in disagg_hosts.env"
     echo "         local: $(echo $_myips | tr '\n' ' ')"
     echo "         expected $PREFILL_HOST (goldenberry) or $DECODE_HOST (disagg-inf-1)"
     echo "         the leases probably changed after an unshelve -- update this file";;
esac
unset _myips
